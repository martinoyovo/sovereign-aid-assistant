{
  "name": "sovereign-aid-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first, offline AI assistant for an NGO's confidential case data. Reasoning by a local Ollama model; all data access through MCP tools. Nothing leaves the machine.",
  "type": "module",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "setup": "npm install && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "dev": "npm run build:web && node --import tsx server/src/index.ts",
    "start": "node --import tsx server/src/index.ts",
    "warmup": "node --import tsx server/src/warmup.ts",
    "mcp": "node --import tsx mcp-server/src/index.ts",
    "web:dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/pdf-parse": "^1.1.5",
    "express": "^4.21.2",
    "pdf-parse": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
